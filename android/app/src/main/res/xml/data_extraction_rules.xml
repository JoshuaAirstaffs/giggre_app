<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup or device-to-device transfer of app data.
     Restoring Firebase Auth's storage without its Keystore key broke
     persistent login (see MainActivity.repairRestoredFirebaseAuthStorage). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
