rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminData().isActive == true &&
        adminData().isPending == false;
    }

    function isSuperAdmin() {
      return isAdmin() && adminData().role == 'super_admin';
    }

    // ─── Gig Points helpers ────────────────────────────────────
    // A valid reward is a non-negative integer (functions/src/gigPoints.ts
    // rejects anything else too — it never rounds).
    // Whole-number floats (10.0) are accepted too: the Firebase console and
    // some SDKs store "10" that way. 12.5 is still rejected.
    function isValidReward(v) {
      return (v is int || (v is float && v == math.floor(v))) && v >= 0;
    }

    // `gigPointsReward` on a gig doc is that task's own reward and takes
    // precedence over the task-type reward. Admin-only (so neither a host
    // nor the worker can set their own reward) and must be valid or null.
    function setsGigPointsReward() {
      return request.resource.data.keys().hasAny(['gigPointsReward']);
    }

    function changesGigPointsReward() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['gigPointsReward']);
    }

    function canWriteGigPointsReward() {
      return isAdmin() && (
        request.resource.data.get('gigPointsReward', null) == null ||
        isValidReward(request.resource.data.gigPointsReward)
      );
    }

    // general_config/gig_points: only the known gig types, each a valid
    // reward; optional cap valid or null; enabled a bool.
    function isValidGigPointsConfig(d) {
      let byType = d.get('pointsByGigType', {});
      return byType is map &&
        byType.keys().hasOnly(['quick', 'open', 'offered']) &&
        (!('quick' in byType) || isValidReward(byType.quick)) &&
        (!('open' in byType) || isValidReward(byType.open)) &&
        (!('offered' in byType) || isValidReward(byType.offered)) &&
        (d.get('maxPointsPerGig', null) == null || isValidReward(d.maxPointsPerGig)) &&
        d.get('enabled', true) is bool;
    }

    // general_config/gig_points_requests: Points ⇄ GigCash conversion.
    // rates.toCash / rates.toPoints = points per 1 unit of wallet currency
    // (positive whole numbers). Per direction, min / max / dailyMax are in
    // points: a positive whole number, or null (= no limit).
    // gigPointsRequests.ts closes a direction with no valid rate and treats
    // other junk as no limit; this keeps junk out in the first place.
    function isValidLimit(v) {
      return v == null || ((v is int || (v is float && v == math.floor(v))) && v > 0);
    }

    function isValidTypeLimits(m) {
      return m is map &&
        m.keys().hasOnly(['enabled', 'min', 'max', 'dailyMax']) &&
        m.get('enabled', false) is bool &&
        isValidLimit(m.get('min', null)) &&
        isValidLimit(m.get('max', null)) &&
        isValidLimit(m.get('dailyMax', null)) &&
        (m.get('min', null) == null || m.get('max', null) == null || m.min <= m.max);
    }

    function isValidConversionRates(m) {
      return m is map &&
        m.keys().hasOnly(['toCash', 'toPoints']) &&
        isValidLimit(m.get('toCash', null)) &&
        isValidLimit(m.get('toPoints', null));
    }

    function isValidGigPointsRequestLimits(d) {
      return d.keys().hasOnly(['enabled', 'rates', 'toCash', 'toPoints', 'updatedAt', 'updatedBy']) &&
        d.get('enabled', true) is bool &&
        (!('rates' in d) || isValidConversionRates(d.rates)) &&
        (!('toCash' in d) || isValidTypeLimits(d.toCash)) &&
        (!('toPoints' in d) || isValidTypeLimits(d.toPoints));
    }

    // general_config/wallet_requests: Gig Wallet request limits (pesos, may
    // have centavos) + the accounts users pay into for a manual top up.
    function isValidAmountLimit(v) {
      return v == null || (v is number && v > 0);
    }

    function isValidWalletTypeLimits(m) {
      return m is map &&
        m.keys().hasOnly(['enabled', 'min', 'max', 'dailyMax']) &&
        m.get('enabled', false) is bool &&
        isValidAmountLimit(m.get('min', null)) &&
        isValidAmountLimit(m.get('max', null)) &&
        isValidAmountLimit(m.get('dailyMax', null)) &&
        (m.get('min', null) == null || m.get('max', null) == null || m.min <= m.max);
    }

    function isValidWalletRequestConfig(d) {
      return d.keys().hasOnly(['enabled', 'deposit', 'transfer', 'withdraw', 'depositAccounts', 'depositNote', 'updatedAt', 'updatedBy']) &&
        d.get('enabled', true) is bool &&
        (!('deposit' in d) || isValidWalletTypeLimits(d.deposit)) &&
        (!('transfer' in d) || isValidWalletTypeLimits(d.transfer)) &&
        (!('withdraw' in d) || isValidWalletTypeLimits(d.withdraw)) &&
        (!('depositAccounts' in d) || (d.depositAccounts is list && d.depositAccounts.size() <= 5)) &&
        (!('depositNote' in d) || (d.depositNote is string && d.depositNote.size() <= 500));
    }

    // The host's approval of a worker's job: gig_detail_sheet.dart sets
    // status 'payment' + paymentCode + paymentInitiatedAt when the host
    // confirms the work. Gig Points (functions/src/gigPoints.ts) are only
    // credited on completion of a doc carrying paymentInitiatedAt. Workers
    // can otherwise update their own gig/slot docs, so without this they
    // could approve their own job. Gig and slot docs both carry hostId.
    function writesHostApprovalAsNonHost() {
      return resource.data.get('hostId', '') != request.auth.uid &&
        (
          (request.resource.data.get('status', '') == 'payment' &&
            resource.data.get('status', '') != 'payment') ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paymentInitiatedAt', 'paymentCode'])
        ) &&
        !isAdmin();
    }

    // Gig chat rooms have a 2-uid `participants` array (support tickets use
    // `userId` instead and are never blockable through this). True if the
    // *other* participant has senderUid in their own blockedUsers list.
    function isBlockedSender(roomId, senderUid) {
      let room = get(/databases/$(database)/documents/chat_rooms/$(roomId)).data;
      return room.keys().hasAny(['participants']) &&
        room.participants.size() == 2 &&
        (
          (room.participants[0] == senderUid &&
            senderUid in get(/databases/$(database)/documents/users/$(room.participants[1])).data.get('blockedUsers', [])) ||
          (room.participants[1] == senderUid &&
            senderUid in get(/databases/$(database)/documents/users/$(room.participants[0])).data.get('blockedUsers', []))
        );
    }

// ─── Rating helpers ────────────────────────────────────────
    // Aggregates are written only by the onRatingCreated Cloud Function
    // (Admin SDK, bypasses rules). Clients submit a ratings/{id} doc and
    // never touch the totals — previously they computed the average
    // themselves and wrote it straight onto the target user doc, so anyone
    // could set their own rating to 5.0 with a modified client.
    //
    // Only the current aggregates are listed. The superseded flat fields
    // (ratingAsWorker / ratingCount / ratingAsHost / ratingAsHostCount) are
    // deliberately left writable: nothing reads them any more, and app
    // versions predating RatingService still write them on every rating.
    // Denying those writes would break older clients to protect dead data.
    function ratingAggregateKeys() {
      return ['ratingWorker', 'ratingHost'];
    }

    function touchesRatingAggregate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(ratingAggregateKeys());
    }

    // A rating is only valid between the two parties to the gig it cites,
    // in the direction it claims. rateeRole 'worker' means the host is
    // rating their worker; 'host' means the worker is rating their host.
    // Multi-worker gigs leave workerId/assignedWorkerId unset on the gig doc
    // and identify a worker by their own `workers/{uid}` slot doc instead —
    // same pattern as the gig update rules below.
    function isRatingCounterparty(data) {
      let gigPath = /databases/$(database)/documents/$(data.gigCollection)/$(data.gigId);
      let gig = get(gigPath).data;
      return data.rateeRole == 'worker'
        ? (gig.hostId == request.auth.uid &&
            (gig.get('workerId', '') == data.rateeId ||
             gig.get('assignedWorkerId', '') == data.rateeId ||
             exists(/databases/$(database)/documents/$(data.gigCollection)/$(data.gigId)/workers/$(data.rateeId))))
        : (gig.hostId == data.rateeId &&
            (gig.get('workerId', '') == request.auth.uid ||
             gig.get('assignedWorkerId', '') == request.auth.uid ||
             exists(/databases/$(database)/documents/$(data.gigCollection)/$(data.gigId)/workers/$(request.auth.uid))));
    }

//     function isApplicant() {
//   // Worker is adding themselves to the applicants map/array
//   // Adjust the field name to match your actual data shape
//   return request.resource.data.diff(resource.data).affectedKeys()
//     .hasOnly(['applicants', 'applicantIds']) &&
//     request.auth.uid in request.resource.data.applicantIds;
// }

    // ─── Gig Wallet ────────────────────────────────────────────
    // Balance + ledger. Owner and admins can read; NOBODY can write from a
    // client. Every change goes through postLedgerEntry() in
    // functions/src/wallet.ts (Admin SDK bypasses these rules).
    // The legacy users/{uid}.balance field is no longer used by the app.
    match /wallets/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if false;
      }
    }

    // ─── Users ─────────────────────────────────────────────────
    match /users/{uid} {
      // Public read — allows unauthenticated referral code lookup during registration
      allow read: if true;
      // ratingWorker/ratingHost are server-only in both directions — a client
      // can neither seed them at registration nor edit them later. No app
      // version has ever written them, so this needs no rollout phasing.
      allow create: if isAuth() &&
        !request.resource.data.keys().hasAny(ratingAggregateKeys());
      allow update: if isAuth() && (!touchesRatingAggregate() || isAdmin());
      allow delete: if isAuth();

      // ─── User Documents ──────────────────────────────────────
      match /documents/{docId} {
        allow read, write: if isUser(uid);
      }

      // ─── Saved Gigs ─────────────────────────────────────────────
      match /savedGigs/{gigId} {
        allow read, write: if isUser(uid);
      }

      // ─── Referrals List ──────────────────────────────────────
      // Owner and admins can read; any authenticated user can write
      // (needed so a new user's registration can write to the referrer's sub-collection)
      match /referrals_list/{referredId} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if isAuth();
      }

      // ─── Badges ──────────────────────────────────────────────
      // Monthly Best host / Best worker awards, written only by the
      // awardMonthlyBadges Cloud Function (Admin SDK). Public to signed-in
      // users so profiles can show them.
      match /badges/{badgeId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

      match /{path=**}/referrals_list/{referredId} {
          allow read: if isAdmin();
        }

    // ─── Worker slots — collection-group reads ─────────────────
    // Nested `match /workers/{workerId}` blocks under quick_gigs/open_gigs/
    // offered_gigs (below) only govern DIRECT subcollection access via a
    // known parent doc id. They do NOT extend to collectionGroup('workers')
    // queries spanning multiple parents (workerHasActiveGig, the worker's
    // active-gig bar, gig history) — those need this separate recursive
    // rule, same pattern as referrals_list above. Writes stay governed by
    // the more specific per-parent rules, since every write goes through a
    // known parent path.
    match /{path=**}/workers/{workerId} {
      allow read: if isAuth();
    }

    // ─── Admins ────────────────────────────────────────────────
    match /admins/{uid} {
      // Existing admins can read the whole collection (admin management
      // page). A signed-in user may also always check their own uid-keyed
      // doc (existent or not — needed so a brand-new admin's first lookup
      // resolves to "not found" instead of "permission denied"), or read
      // their own still-pending invite by email so they can find and
      // consume it on first sign-in.
      allow read: if isAdmin() ||
        uid == request.auth.uid ||
        isOwnPendingInvite();

      // Admin management (inviting/editing other admins) stays
      // super-admin-only. The one exception is a user promoting
      // themselves into their own uid-keyed doc, which is only allowed
      // if it exactly mirrors an existing pending invite for their email.
      allow create: if isSuperAdmin() || isValidSelfPromotion(uid);
      allow update: if isSuperAdmin();

      // Consuming (deleting) your own pending invite after promotion is
      // allowed; everything else stays non-deletable.
      allow delete: if isSuperAdmin() || isOwnPendingInvite();
    }

    // ─── Skills ────────────────────────────────────────────────
    match /skills/{skillId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Skills Requests ───────────────────────────────────────
    match /skill_requests/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ─── Chat Rooms ────────────────────────────────────────────
    match /chat_rooms/{roomId} {
      // get: single-doc reads (support + gig chats + non-existent doc check)
      allow get: if isAuth() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      // list: collection queries — support uses where('userId'), gig uses arrayContains('participants')
      allow list: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, update, delete: if isAuth() && (
          get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.userId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
          || isAdmin()
        );
        // Same participant check as above, plus: reject if the recipient has
        // blocked the sender (client-side blocking only hides/disables the
        // composer — this is what actually stops a blocked user's messages).
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.userId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
        ) && !isBlockedSender(roomId, request.auth.uid);
      }
    }

    // ─── User Reports ──────────────────────────────────────────
    // Effectively create-only for regular users: the one exception is
    // reading back a report THEY filed (never another user's), which
    // ReportService needs to detect an already-pending duplicate report on
    // the same contentId before showing the form again. No one can browse
    // other users' reports, and only admins can update/delete.
    match /reports/{reportId} {
      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin() ||
        (isAuth() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ─── Support Tickets ───────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientType == 'all' ||
        (resource.data.recipientType == 'specific' &&
          request.auth.uid in resource.data.recipients) ||
        isAdmin()
      );
      allow create: if true;
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Support Settings ──────────────────────────────────────
    match /support_settings/{docId} {
      allow read: if isAuth();
      allow write: if true;
    }

    // ─── User Requests ─────────────────────────────────────────
    match /user_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────
    match /notifications/{notifId} {
      allow get: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Workers notify a gig's host when they apply — restricted to that one
      // category, and the caller can only claim their own worker identity.
      allow create: if isAdmin() || (
        isAuth() &&
        request.resource.data.category == 'new_applicant' &&
        request.resource.data.workerId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ─── App Content (public read) ─────────────────────────────
    match /app_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_content/{docId}/items/{itemId} {
      allow read: if true;
        allow write: if isAdmin();
    }

    // ─── Gig Points ────────────────────────────────────────────
    // Balance doc + immutable ledger, written ONLY by the gigPoints Cloud
    // Functions (Admin SDK). Kept out of users/{uid} on purpose: that doc is
    // client-writable, so a balance there could be edited by a modified app.
    match /gig_points/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if false;
      }
    }

    // ─── Gig Points requests ───────────────────────────────────
    // Points ⇄ GigCash conversion requests (functions/src/gigPointsRequests.ts).
    // Created, cancelled and decided ONLY through callables, which hold
    // points or GigCash, enforce rates/limits and notify admins. The owner and admins read.
    // gig_points/{uid}/daily/* (daily-cap counters) has no rule → no access.
    match /gig_points_requests/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─── Gig Wallet requests ───────────────────────────────────
    // Top Up / Send requests (functions/src/walletRequests.ts). Created,
    // cancelled and decided ONLY through callables. Owner and admins read.
    // wallets/{uid}/daily/* (daily-cap counters) has no rule → no access.
    match /wallet_requests/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─── Gig Points config issues ──────────────────────────────
    // Raised by the gigPoints Cloud Functions when a task has no valid
    // reward configured (its points are held, not awarded) — admin-only.
    // Resolved via the retryGigPointsAwards callable.
    match /gig_points_config_issues/{issueId} {
      allow read: if isAdmin();
      allow write: if false;

      match /tasks/{taskId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ─── Referral settings ─────────────────────────────────────
    // Reward rates per referral level (default rate, time-limited rate and
    // date range, maximum earnings), edited in giggre-admin's
    // Referrals → Referral settings. Readable by any signed-in user so the
    // app can show the current rates.
    match /referral_settings/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin() ||
        (isAdmin() && 'referrals' in adminData().get('permissions', []));
    }

    // ─── Badge awards ──────────────────────────────────────────
    // One doc per month with that month's winners — written only by the
    // awardMonthlyBadges Cloud Function, read by giggre-admin's Analytics.
    match /badge_awards/{monthId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Activity Logs ─────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Counters ──────────────────────────────────────────────
    match /_counters/guest_support_tickets {
      allow read, write: if true;
    }

    match /_counters/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ─── Quick Gigs ────────────────────────────────────────────
    match /quick_gigs/{gigId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.hostId == request.auth.uid &&
        (!setsGigPointsReward() || canWriteGigPointsReward());
      allow update: if (!changesGigPointsReward() || canWriteGigPointsReward()) && isAuth() &&
        !writesHostApprovalAsNonHost() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        (resource.data.assignedWorkerId == request.auth.uid && resource.data.hostId != request.auth.uid) ||
        // Multi-worker gigs: a candidate declining/timing out writes
        // exclusionList on the parent doc directly (quick_gig_matching_
        // service.dart / _declineDispatch) — they're not `workerId`/
        // `assignedWorkerId` (those stay unset for multi-worker gigs), so
        // identify them by having their own slot doc instead.
        exists(/databases/$(database)/documents/quick_gigs/$(gigId)/workers/$(request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAuth() && ( resource.data.hostId == request.auth.uid || isAdmin() );

      // ─── Worker slots (multi-worker gigs) ────────────────────
      // Each worker owns only their own slot doc; the gig's host owns all
      // slots (assign/track/pay); hostId is denormalized onto every slot
      // doc so this stays get()-free.
      match /workers/{workerId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          request.resource.data.hostId == request.auth.uid ||
          request.auth.uid == workerId ||
          isAdmin()
        );
        allow update: if isAuth() && !writesHostApprovalAsNonHost() && (
          request.auth.uid == workerId ||
          resource.data.hostId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ─── Open Gigs ─────────────────────────────────────────────
   match /open_gigs/{gigId} {
    allow read: if isAuth();
    allow create: if isAuth() &&
      request.resource.data.hostId == request.auth.uid &&
      (!setsGigPointsReward() || canWriteGigPointsReward());
    allow update: if (!changesGigPointsReward() || canWriteGigPointsReward()) && isAuth() &&
        !writesHostApprovalAsNonHost() && (
      resource.data.hostId == request.auth.uid ||
      resource.data.workerId == request.auth.uid ||
      resource.data.assignedWorkerId == request.auth.uid ||
      resource.data.status == 'open' ||
      // Multi-worker gigs keep accepting applicants (arrayUnion on
      // `applicants`) past the first assignment, once status has moved off
      // 'open' to 'partially_filled' — see acceptingMoreSlots in
      // gig_detail_sheet.dart / _applyToOpenGig in gig_map_section.dart.
      resource.data.status == 'partially_filled' ||
      // Multi-worker gigs: a worker confirming payment (QR/code entry in
      // worker_payment_confirm_sheet.dart) bumps slotsCompleted/status on
      // the parent doc directly — identify them by having their own slot
      // doc, since workerId/assignedWorkerId stay unset for multi-worker
      // gigs. Missing this (unlike quick_gigs/offered_gigs, which already
      // have it) is why payment confirmation fails with 2+ worker slots.
      exists(/databases/$(database)/documents/open_gigs/$(gigId)/workers/$(request.auth.uid)) ||
      isAdmin()
    );

    allow delete: if isAuth() && (
      resource.data.hostId == request.auth.uid || isAdmin()
    );

    // ─── Worker slots (multi-worker gigs) ──────────────────────
    match /workers/{workerId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.hostId == request.auth.uid ||
        request.auth.uid == workerId ||
        isAdmin()
      );
      allow update: if isAuth() && !writesHostApprovalAsNonHost() && (
        request.auth.uid == workerId ||
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }

    // ─── Offered Gigs ──────────────────────────────────────────
    match /offered_gigs/{gigId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.hostId == request.auth.uid &&
        (!setsGigPointsReward() || canWriteGigPointsReward());
      allow update: if (!changesGigPointsReward() || canWriteGigPointsReward()) && isAuth() &&
        !writesHostApprovalAsNonHost() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        resource.data.assignedWorkerId == request.auth.uid ||
        // Multi-worker gigs: an accepting worker bumps filledSlotCount/
        // status on the parent doc directly (_acceptOfferedGig's
        // transaction) — identify them by having their own slot doc,
        // since workerId/assignedWorkerId stay unset for multi-worker gigs.
        exists(/databases/$(database)/documents/offered_gigs/$(gigId)/workers/$(request.auth.uid)) ||
        isAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.hostId == request.auth.uid || isAdmin()
      );

      // ─── Worker slots (multi-worker gigs) ────────────────────
      match /workers/{workerId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          request.resource.data.hostId == request.auth.uid ||
          request.auth.uid == workerId ||
          isAdmin()
        );
        allow update: if isAuth() && !writesHostApprovalAsNonHost() && (
          request.auth.uid == workerId ||
          resource.data.hostId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ─── Quick Gig Config ──────────────────────────────────────
    match /quick_gig_config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Gig Templates ─────────────────────────────────────────
    match /gig_templates/{templateId} {
      allow read: if isAuth() &&
        resource.data.hostId == request.auth.uid;
      allow create: if isAuth() &&
        request.resource.data.hostId == request.auth.uid;
      allow update: if isAuth() &&
        resource.data.hostId == request.auth.uid;
      allow delete: if isAuth() &&
        resource.data.hostId == request.auth.uid;
    }

    // ─── General Config ────────────────────────────────────────
    match /general_config/maintenance {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Read by every signed-in user at startup (CurrentUserProvider's
    // _listenToGigVisibilityRules) to check allowGigAccessForUnverified —
    // needs the same non-admin read access as maintenance above, or that
    // listener hits permission-denied for every regular user.
    match /general_config/gig_visibility_rules {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // Gig Points reward config — read by the app to show the configured
    // reward per gig type; only the gigPoints Cloud Functions act on it.
    match /general_config/gig_points {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() &&
        isValidGigPointsConfig(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Gig Points conversion rates + limits — read by the app to show the rate
    // and limits; enforced by the gigPointsRequests Cloud Functions.
    match /general_config/gig_points_requests {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() &&
        isValidGigPointsRequestLimits(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Gig Wallet request limits + top-up accounts — read by the app; enforced
    // by the walletRequests Cloud Functions.
    match /general_config/wallet_requests {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() &&
        isValidWalletRequestConfig(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /general_config/{docId} {
      allow read: if isAdmin();
      // gig_points / gig_points_requests / wallet_requests have their own
      // validated rules above;
      // rules OR together, so they must be excluded here or this would
      // bypass that validation.
      allow write: if isSuperAdmin() && !(docId in ['gig_points', 'gig_points_requests', 'wallet_requests']);
    }

    // ─── Account Delete Requests ────────────────────────────────
    // Written by delete_acc_service.dart (create on request, update on
    // cancel) and read back by main.dart/home_screen.dart to surface the
    // live status on the pendingDeletion gate screen. Also written by the
    // website's delete-account page, which tags its own docs with
    // source: 'web' (the app's docs carry no source field at all — the
    // field is optional so this stays backward-compatible with the app).
    // Owner may only move their own request to 'cancelled' — everything
    // else (approve/complete/edit) is admin-only via giggre-admin, so a
    // user can't self-approve or forge other fields.
    match /account_delete_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        (!('source' in request.resource.data) || request.resource.data.source == 'web');
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status in ['pending_deletion', 'approved'] &&
        request.resource.data.status == 'cancelled'
      );
      allow delete: if isAdmin();
    }
    
        // ─── Admin Notifications ────────────────────────────────────
    // Centralized, permission-aware notification center for admins.
    // Only written by Cloud Functions (Admin SDK bypasses these rules) —
    // clients may only read notifications matching a permission they
    // currently hold, and may only toggle their own key in `readBy`.
    match /admin_notifications/{notifId} {
      allow read: if isAdmin() && (
        isSuperAdmin() || resource.data.requiredPermission in adminData().permissions
      );
      allow create: if false;
      allow update: if isAdmin() && (
        isSuperAdmin() || resource.data.requiredPermission in adminData().permissions
      ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.readBy[request.auth.uid] == true;
      allow delete: if false;
    }

    // ─── Mail (Firebase "Trigger Email" extension) ──────────────
    // Written only by our Cloud Functions (Admin SDK, bypasses rules) and
    // consumed only by the extension's own Cloud Function (same). No
    // client ever needs to read or write this directly.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // ─── Ratings ───────────────────────────────────────────────
    // Append-only, one doc per (gig, rater, ratee). The doc id is bound to
    // those three below, so a duplicate submission is rejected here rather
    // than being double-counted into an aggregate. Aggregation, reveal, and
    // comment moderation all happen server-side in functions/src/ratings.ts.
    match /ratings/{ratingId} {
      // Hidden until revealed — a rater can always see their own, and the
      // pair is revealed together once both sides have rated (or after the
      // window closes) so neither can wait to see the other's first.
      allow read: if isAuth() && (
        resource.data.revealedAt != null ||
        resource.data.raterId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuth() &&
        request.resource.data.raterId == request.auth.uid &&
        request.resource.data.rateeId != request.auth.uid &&
        request.resource.data.rateeRole in ['worker', 'host'] &&
        request.resource.data.gigCollection in
          ['quick_gigs', 'open_gigs', 'offered_gigs'] &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 6 &&
        request.resource.data.get('comment', '').size() <= 500 &&
        // Server-owned fields must start empty so a client can't submit a
        // pre-aggregated or pre-revealed rating.
        request.resource.data.aggregated == false &&
        request.resource.data.revealedAt == null &&
        request.resource.data.createdAt == request.time &&
        ratingId == request.resource.data.gigCollection + '__' +
          request.resource.data.gigId + '__' + request.auth.uid + '__' +
          request.resource.data.rateeId &&
        isRatingCounterparty(request.resource.data);

      // Editable only by its author, and only until it is revealed.
      allow update: if isAuth() &&
        resource.data.raterId == request.auth.uid &&
        resource.data.revealedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stars', 'tags', 'comment']) &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5;

      allow delete: if isAdmin();
    }

    // ─── Verification Requests ─────────────────────────────────
    match /verification_requests/{userId} {
      allow read, create: if request.auth != null &&
        request.auth.uid == userId;
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.status in ['pending', 'cancelled'];
      allow read, create, update: if isAdmin();
    }

  }
}
